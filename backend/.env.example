# Cookie
COOKIE_SECRET=change_me_cookie_secret

# ─────────────────────────────────────────────
# GOOGLE SIGN-IN (via Firebase Auth)
# ─────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Local dev: save the downloaded JSON here (this path is
# git-ignored) and use FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Hosted deploy (Render, etc. — no file upload): instead paste the entire
# downloaded JSON file's contents as one line into FIREBASE_SERVICE_ACCOUNT_JSON
# in your host's environment variable settings. Takes priority over the PATH
# above when both are set. Leave unset for local dev.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

